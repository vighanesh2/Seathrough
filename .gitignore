# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
.cache/
scripts/.smoke-*.cjs

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# vercel
.vercel

# python
__pycache__/
*.py[cod]
.venv/
backend/out/

# typescript
*.tsbuildinfo
next-env.d.ts

# vendor icon clone (keep out of app git; transform via npm run ingest:svgs)
/tabler-icons

# local research / dataset folders (not part of the Next deploy)
/Analytics-Dashboard
/metaphor-dataset
