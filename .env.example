# LLM — default Groq for free-tier prototyping
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Optional fallback / preferred for /automatic-drawing and vision screenshots
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
OPENAI_VISION_MODEL=gpt-4.1

# Optional Groq vision model (used when OPENAI_API_KEY is unset)
GROQ_VISION_MODEL=qwen/qwen3.6-27b

# Voice
DEEPGRAM_API_KEY=
DEEPGRAM_TTS_MODEL=aura-2-thalia-en

# Token compression (Pipe A/B). Default on. Set to 0 to disable.
TOKEN_COMPRESSION_ENABLED=1

# Independent job judge on live ship_short. Default OFF (week one: eval/gold only).
# Enable only after human agreement on all 17 A gold rows (ship-short vs failure note).
# TOKEN_COMPRESSION_RUNTIME_JOB_JUDGE=1

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
